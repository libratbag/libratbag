[Device]
Name=ASUS ROG Keris II Origin
DeviceMatch=usb:0b05:1c0c
DeviceType=mouse
Driver=asus

# Wired. Behind the ASUS Omni receiver the mouse is handled by
# asus-rog-keris-ii-origin-omni.device.
[Driver/asus]
Profiles=5
Buttons=8
Leds=3
Dpis=4
Wireless=1
DpiRange=100:42000@50
Quirks=SEPARATE_XY_DPI;LED_V2;SETTINGS_V2
