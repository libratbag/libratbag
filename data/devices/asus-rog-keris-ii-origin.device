[Device]
Name=ASUS ROG Keris II Origin
DeviceMatch=usb:0b05:1c0c;usb:0b05:1c0e
DeviceType=mouse
Driver=asus

# Wired the mouse enumerates as usb 0b05:1c0c. Behind the ASUS Omni
# receiver (0b05:1ace) it is listed as 0b05:1c0e and resolved during
# probe by its serial number signature prefix (OmniSignature).
[Driver/asus]
Profiles=5
Buttons=8
Leds=3
Dpis=4
Wireless=1
DpiRange=100:42000@50
Quirks=OMNI_RECEIVER;SEPARATE_XY_DPI;LED_V2;SETTINGS_V2
OmniSignature=02
