# Official utility: "T-TGM301 Wired Gaming Mouse".
# MDNUM=6 (2 modes), but the second mode is empty on a fresh mouse and
# selecting it fails with "Broken pipe", so only one profile is exposed.
[Driver/sinowealth/devices/2732]
Buttons=7
DeviceName=T-Dagger Lieutenant T-TGM301
LedType=RGB
Profiles=1
SensorType=PAW3325

